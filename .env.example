# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# NEXUS runs WITHOUT any of this. With no key configured, routing falls back to
# its built-in rules, insights and forecasts are computed locally as always, the
# data assistant still answers questions it can recognise -- in templated
# wording rather than its own -- and the help chat answers from a built-in FAQ.
# What a key buys is fluency and a wider range of understood phrasings, not
# correctness. No number shown anywhere in this app is ever written by a model.

# Which provider to use: "deepseek" or "gemini". Any other value turns the LLM
# off entirely and the app runs on its rule-based paths, which is a supported
# way to deploy it. See core/llm.py -- it is the only module that talks to a
# provider, so adding a third is one function there and nothing else.
AI_PROVIDER=deepseek

# --- DeepSeek (the default) -------------------------------------------------
# Get a key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-key-here

# The OpenAI-compatible base URL. Overridable so this can be pointed at any
# compatible endpoint -- a local server, an internal gateway -- without a code
# change. No trailing slash, no /v1 suffix.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# The model id. "deepseek-chat" is DeepSeek's general model and is what this
# was built against.
DEEPSEEK_MODEL=deepseek-chat

# --- Google Gemini (alternative) --------------------------------------------
# Used only when AI_PROVIDER=gemini. Get a key from
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# The Gemini model id, overridable because it is a live dependency rather than
# a free choice -- Google retires model ids, and gemini-2.0-flash already 404s.
# Setting this means a retirement is a config change, not a code change.
NEXUS_AI_MODEL=gemini-3.6-flash
